{
  "name": "@v-contrib/storybook-vue-addon",
  "type": "module",
  "version": "0.9.0",
  "description": "Write Storybook stories using Vue SFC's",
  "author": "Jogai",
  "license": "MPL-2.0",
  "homepage": "https://github.com/v-contrib/storybook-vue-addon#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/v-contrib/storybook-vue-addon.git"
  },
  "bugs": {
    "url": "https://github.com/v-contrib/storybook-vue-addon/issues"
  },
  "keywords": [
    "storybook",
    "vue",
    "addon",
    "csf"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./preset": {
      "types": "./dist/preset.d.ts",
      "import": "./dist/preset.js"
    },
    "./vite-plugin": {
      "types": "./dist/vite-plugin.d.ts",
      "import": "./dist/vite-plugin.js"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "import": "./dist/router.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prepublishOnly": "npm run build",
    "test:vue-router-4": "VUE_ROUTER=4 vitest run src/__tests__/router.test.ts"
  },
  "peerDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "storybook": "^10.0.0 || ^11.0.0-0",
    "vite": "^8.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "eslint": "^10.15.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "unplugin-vue-macros": "^2.14.5",
    "vitest": "^5.1.1",
    "vue": "^3.5.46",
    "vue-router": "^5.5.1",
    "vue-router-4": "npm:vue-router@^4.6.5"
  },
  "peerDependenciesMeta": {
    "vue-router": {
      "optional": true
    }
  }
}
