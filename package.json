{
  "name": "@v-contrib/storybook-vue-addon",
  "type": "module",
  "version": "0.2.0",
  "description": "Write Storybook stories using Vue SFC's",
  "author": "Jogai",
  "license": "MPL-2.0",
  "homepage": "https://github.com/v-contrib/storybook-vue-addon#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/v-contrib/storybook-vue-addon.git"
  },
  "bugs": {
    "url": "https://github.com/v-contrib/storybook-vue-addon/issues"
  },
  "keywords": [
    "storybook",
    "vue",
    "addon",
    "csf"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./preset": {
      "types": "./dist/preset.d.ts",
      "import": "./dist/preset.js"
    },
    "./vite-plugin": {
      "types": "./dist/vite-plugin.d.ts",
      "import": "./dist/vite-plugin.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "storybook": "^10.0.0",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "@vue/compiler-sfc": "^3.5.27"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.2.0",
    "eslint": "^9.39.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vue": "^3.5.27"
  }
}
